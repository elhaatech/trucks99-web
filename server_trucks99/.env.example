# MongoDB
MONGODB_ATLAS=mongodb://localhost:27017/trucks99

# Server
PORT=3003
NODE_ENV=development

# Firebase Admin SDK (backend push notifications)
# Use ONE of the options below — never commit real credentials to Git.

# Option A: path to downloaded service account JSON (local development)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: full service account JSON as a single-line string (recommended for Azure/Heroku/Railway)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option C: base64-encoded service account JSON (some CI/CD pipelines)
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option D: individual fields (common on PaaS secret managers)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option E: Google application default credentials file path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Enable unauthenticated /api/test-firebase-easy in production (default: disabled)
# ENABLE_FIREBASE_TEST_ENDPOINT=false
