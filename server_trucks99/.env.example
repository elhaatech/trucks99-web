# MongoDB
MONGODB_ATLAS=mongodb://localhost:27017/trucks99

# Server
PORT=3003
NODE_ENV=production

# OTP login (Redis + Draft4SMS — required in production)
OTP_SECRET=change-me-in-production
OTP_EXPIRATION_MINUTES=10
OTP_LENGTH=4
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_RESEND=3
REDIS_URL=redis://127.0.0.1:6379
DRAFT4SMS_API_KEY=your_draft4sms_api_key
DRAFT4SMS_SENDER_ID=TRUKXX
# OTP_SMS_MESSAGE_TEMPLATE={otp} is the OTP for your Trucks99 Login - Team Trucks99

# Next.js production — proxy /api/* to backend on same machine
# BACKEND_INTERNAL_URL=http://127.0.0.1:3003

# CORS — frontend origins (include port if used)
# CORS_ORIGINS=http://truck.elhaa.com:3002,https://truck.elhaa.com:3002
# CLIENT_URL=http://truck.elhaa.com:3002

# Firebase Admin SDK (backend push notifications)
# Use ONE of the options below — never commit real credentials to Git.

# Option A: path to downloaded service account JSON (local development)
# Default lookup order (if unset): firebase-service-account.json, then firebase-service-account..json
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: full service account JSON as a single-line string (recommended for Azure/Heroku/Railway)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option C: base64-encoded service account JSON (some CI/CD pipelines)
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option D: individual fields (common on PaaS secret managers)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option E: Google application default credentials file path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Android notification channel (must match React Native app — default: trucks99_default)
# FCM_ANDROID_CHANNEL_ID=trucks99_default

# Enable unauthenticated /api/test-firebase-easy in production (default: disabled)
# ENABLE_FIREBASE_TEST_ENDPOINT=false
