# Copy to .env.local for local `next dev`.
# Copy to .env.production for `next build` / `next start` on the server.
# NEXT_PUBLIC_* values are baked in at build time — rebuild after changing them.

# --- Local (http://localhost:3002) ---
# Leave ASSET_PREFIX unset so chunks load from /_next on this port.
NEXT_PUBLIC_API_URL=http://localhost:3003

# --- Production (https://trucks99.elhaa.com/user/) ---
# Apache already serves JS at /user/_next/... . Set this so HTML requests that prefix.
# NEXT_PUBLIC_ASSET_PREFIX=/user
# NEXT_PUBLIC_API_URL=https://trucks99.elhaa.com

# Google Maps / Places
NEXT_PUBLIC_GOOGLE_API_KEY=

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-2600927533607135

# Truck99_Web_Responsive (used by all placements unless overridden)
NEXT_PUBLIC_ADSENSE_SLOT=6835182258

# Optional per-page units — leave unset to reuse Truck99_Web_Responsive
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_MY_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_DETAILS=
NEXT_PUBLIC_ADSENSE_SLOT_FEATURED=
NEXT_PUBLIC_ADSENSE_SLOT_SELLER=
NEXT_PUBLIC_ADSENSE_SLOT_PURCHASES=
NEXT_PUBLIC_ADSENSE_SLOT_POPUP=
