# Copy to .env.local for local `next dev`.
# Copy to .env.production for `next build` / `next start` on the server.
# NEXT_PUBLIC_* values are baked in at build time — rebuild after changing them.

# --- Local (http://localhost:3004) ---
# Leave ASSET_PREFIX unset so chunks load from /_next on this port.
NEXT_PUBLIC_API_URL=http://localhost:3003
NEXT_PUBLIC_APP_BASE=/admin/portal

# --- Production (https://trucks99.elhaa.com/admin/) ---
# Apache already serves JS at /admin/_next/... . Set this so HTML requests that prefix.
# NEXT_PUBLIC_ASSET_PREFIX=/admin
# NEXT_PUBLIC_API_URL=https://trucks99.elhaa.com

# Google Maps / Places (required for the Maps script on login)
NEXT_PUBLIC_GOOGLE_API_KEY=
